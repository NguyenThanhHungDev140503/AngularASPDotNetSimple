{
  "ConnectionStrings": {
    "DefaultConnection": "Server=production-server;Database=TheShoe;User Id=productapi;Password=your-secure-password;MultipleActiveResultSets=true;TrustServerCertificate=false;Encrypt=true"
  },
  "Api": {
    "ApplicationName": "Product API",
    "Version": "1.0.0",
    "Environment": "Production",
    "BaseUrl": "https://api.productmanagement.com",
    "RequestTimeout": 60,
    "MaxRequestsPerMinute": 5000,
    "EnableDetailedErrors": false,
    "EnableVersioning": true,
    "EnableCompression": true
  },
  "Security": {
    "JwtSecretKey": "CHANGE-THIS-TO-A-VERY-SECURE-SECRET-KEY-IN-PRODUCTION-AT-LEAST-64-CHARACTERS",
    "JwtExpirationMinutes": 30,
    "JwtIssuer": "ProductAPI",
    "JwtAudience": "ProductAPI.Client",
    "AllowedOrigins": [
      "https://productmanagement.com",
      "https://www.productmanagement.com"
    ],
    "RequireHttps": true,
    "EnableHsts": true,
    "HstsMaxAge": 31536000,
    "EnableRateLimiting": true,
    "RateLimitPerMinute": 60
  },
  "Database": {
    "CommandTimeout": 60,
    "MaxRetryCount": 5,
    "RetryDelay": 2000,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "Logging": {
    "DefaultLogLevel": "Warning",
    "AspNetCoreLogLevel": "Warning",
    "EntityFrameworkLogLevel": "Warning",
    "EnableConsoleLogging": true,
    "EnableFileLogging": true,
    "LogFilePath": "/var/log/productapi/productapi.log",
    "MaxLogFileSizeMB": 50,
    "MaxLogFileCount": 10,
    "EnableStructuredLogging": true,
    "LogRequestResponse": false,
    "LogSqlQueries": false
  }
}
