{

  "Api": {
    "ApplicationName": "Product API",
    "Version": "1.0.0",
    "Environment": "Development",
    "BaseUrl": "http://localhost:5046",
    "RequestTimeout": 30,
    "MaxRequestsPerMinute": 1000,
    "EnableDetailedErrors": true,
    "EnableVersioning": true,
    "EnableCompression": true
  },
  "Security": {
    "JwtSecretKey": "your-super-secret-jwt-key-that-should-be-at-least-32-characters-long-for-security",
    "JwtExpirationMinutes": 60,
    "JwtIssuer": "ProductAPI",
    "JwtAudience": "ProductAPI.Client",
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:3000"
    ],
    "RequireHttps": false,
    "EnableHsts": false,
    "HstsMaxAge": 31536000,
    "EnableRateLimiting": true,
    "RateLimitPerMinute": 100
  },
  "Database": {
    "CommandTimeout": 30,
    "MaxRetryCount": 3,
    "RetryDelay": 1000,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": true
  },
  "Logging": {
    "DefaultLogLevel": "Information",
    "AspNetCoreLogLevel": "Warning",
    "EntityFrameworkLogLevel": "Information",
    "EnableConsoleLogging": true,
    "EnableFileLogging": false,
    "LogFilePath": "logs/productapi.log",
    "MaxLogFileSizeMB": 10,
    "MaxLogFileCount": 5,
    "EnableStructuredLogging": true,
    "LogRequestResponse": false,
    "LogSqlQueries": true
  },
  "AllowedHosts": "*"
}
